# URL HTTPS du serveur backend distant utilisé par l'APK et l'application hébergée
VITE_API_BASE_URL=https://api.ton-domaine.tld

# Clé de chiffrement AES-256-GCM du serveur (32 octets hexadécimaux)
# Générer avec : openssl rand -hex 32
CHLOE_ENCRYPTION_KEY=

# Origines autorisées par CORS (séparées par des virgules)
# Pour Capacitor Android, inclure https://localhost
CHLOE_ALLOWED_ORIGINS=https://localhost,https://ton-domaine.tld
